{
  "manifest_version": 3,
  "name": "Just-Save-It — Quick Link Saver",
  "version": "1.0.0",
  "description": "ดึง URL แท็บปัจจุบันพร้อมภาพปก แท็ก โฟลเดอร์ เตือนอ่าน และสรุป AI บันทึกตรงเข้า Just-Save-It Backend",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Just-Save-It",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "quick-save-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Quick-save the active tab directly to Just-Save-It"
    }
  }
}
