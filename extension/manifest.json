{
  "manifest_version": 3,
  "name": "Just-Save-It — Quick Link Saver",
  "version": "1.1.0",
  "description": "ดึง URL แท็บปัจจุบันพร้อมภาพปก แท็ก โฟลเดอร์ เตือนอ่าน และสรุป AI บันทึกตรงเข้า Just-Save-It Backend",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "contextMenus",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://just-save-it-api.onrender.com/*",
    "https://just-save-it-web.onrender.com/*",
    "https://pnqjamwhgzqzvpiytcln.supabase.co/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "http://[::1]:*/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://just-save-it-web.onrender.com/*",
      "http://localhost:4173/*",
      "http://127.0.0.1:4173/*",
      "http://localhost:3000/*"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Just-Save-It",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://just-save-it-web.onrender.com/*",
        "http://localhost:4173/*",
        "http://127.0.0.1:4173/*",
        "http://localhost:3000/*"
      ],
      "js": ["web_bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "quick-save-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Quick-save the active tab directly to Just-Save-It"
    }
  }
}
