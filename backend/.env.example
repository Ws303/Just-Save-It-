# Just-Save-It Backend Environment Configuration

# ===== Tier 1: Built-in Free AI Models =====
# Primary: Google Gemini Flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Failover: Groq Cloud (automatic backup on 429 rate limit or timeout)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Built-in Free Monthly Quota (per free user)
FREE_TIER_MONTHLY_AI_LIMIT=50

# ===== Supabase Configuration =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ===== Application URL =====
# Used for generating invite links (e.g., https://app.justsaveit.com/invite/<token>)
APP_URL=https://app.justsaveit.com

# ===== Server Host & Port =====
HOST=0.0.0.0
PORT=8000

# ===== Tier 2 & Tier 3 Reference (Client-provided via Headers - No server env needed) =====
# Header examples sent by client:
# Tier 2 (BYOK):
#   X-AI-Provider: openai | gemini | anthropic | openrouter | groq
#   X-AI-Key: sk-...
#   X-AI-Model: gpt-4o-mini (optional)
# Tier 3 (Custom / Local Endpoint):
#   X-AI-Base-Url: http://localhost:11434/v1
#   X-AI-Model: llama3.2
#   X-AI-Key: optional-bearer-token
